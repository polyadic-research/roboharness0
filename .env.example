# RoboCasa365 / Xiaomi 2.0 submission configuration.
# Copy to a private .env file; exported process variables take precedence.
RPENT_REPO_ROOT=.

# Filled by the isolated installer's environment.sh, or set explicitly.
# RPENT_ROBOCASA_PYTHON=/path/to/runtime/simulator/bin/python
# RPENT_XIAOMI_MIBOT_PYTHON=/path/to/runtime/policy/bin/python
# RPENT_XIAOMI_MIBOT_SNAPSHOT=/path/to/runtime/checkpoint
MUJOCO_GL=egl
CUDA_VISIBLE_DEVICES=0
RPENT_SHARED_SERVICE_TIMEOUT_S=
RPENT_BENCHMARK_PREVIEW_TIMEOUT_S=120

# Private planner API access, supplied separately; never commit populated values.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model/settings: evaluations/robocasa365/2.0/planner.json
# The supplied API selects gpt-6-astra with xhigh reasoning; the frozen client
# sends no reasoning-effort knob. HTTP timeout330, nested planning180,
# outer whole-solve timeout unset. Historical overrides remain disclosed.

# Cache and persistent state stay outside the publication file boundary.
RPENT_HOME=.runtime/home
XDG_CACHE_HOME=.runtime/cache
UV_CACHE_DIR=.runtime/cache/uv
HF_HOME=.runtime/cache/huggingface
NUMBA_CACHE_DIR=logs/numba-cache
MPLCONFIGDIR=logs/matplotlib
